# =============================================================================
# EventPilot AI — Environment Configuration
# =============================================================================

# Server Port (automatically injected by Google Cloud Run)
PORT=8080
ENVIRONMENT=development

# Gemini AI Authentication (Vertex AI with ADC default)
# For local development with gcloud ADC:
#   run: gcloud auth application-default login
#   set GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional Local-Dev API Key Fallback:
GEMINI_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20.0

# CORS Allowed Origins
# Development: defaults to localhost:5173, 127.0.0.1:5173, localhost:8080
# Production: leave empty for same-origin or provide comma-separated origins (never *)
CORS_ORIGINS=

# Proxy & Rate Limiting
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Max Request Payload Size (bytes; 1048576 = 1MB)
MAX_BODY_BYTES=1048576
