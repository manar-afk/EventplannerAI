# =============================================================================
# EventPilot AI — Environment Configuration
# =============================================================================

# Server Port (automatically supplied by Google Cloud Run)
PORT=8080
ENVIRONMENT=development

# Gemini AI Authentication
# OPTION A (Local Development): Provide API Key from Google AI Studio
GEMINI_API_KEY=

# OPTION B (Google Cloud Run / Production):
# Leave GEMINI_API_KEY blank. The google-genai SDK uses Application Default
# Credentials (ADC) attached to the Cloud Run service account or Secret Manager.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Model Name (Verify current model availability, e.g., gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=18.0

# CORS Allowed Origins (Comma-separated or * for public endpoints)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# In-Memory Rate Limiting (per instance, evaluated on X-Forwarded-For)
RATE_LIMIT_PER_MINUTE=20

# Max Request Payload Size (bytes; 1048576 = 1MB)
MAX_BODY_BYTES=1048576
